\contentsline {figure}{\numberline {4.1}{\ignorespaces Vista de Resumen de la sesión: mapa del circuito dibujado desde la telemetría, condiciones meteorológicas y estadísticas de la carrera.}}{52}{figure.caption.22}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Vista de Cronología de Eventos: reconstrucción de la secuencia de banderas, \textit {Safety Car} y \textit {VSC} a lo largo de la sesión a partir de los códigos de \texttt {track\_status}.}}{53}{figure.caption.23}%
